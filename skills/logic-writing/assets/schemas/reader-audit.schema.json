{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/reader-audit.schema.json",
  "title": "Logic Writing deterministic ReaderAudit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "final_owner", "route_decision_fingerprint",
    "reader_intent_fingerprint", "reader_brief_fingerprint", "composition_plan_fingerprint",
    "artifact_map_fingerprint", "shared_writing_contract_fingerprint", "artifact_fingerprint",
    "visible_unit_ids", "structure_metrics", "findings", "quality_dimensions",
    "status", "audited_at", "audit_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "audit_id": { "$ref": "#/$defs/id" },
    "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
    "route_decision_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_brief_fingerprint": { "$ref": "#/$defs/fp" },
    "composition_plan_fingerprint": { "$ref": "#/$defs/fp" },
    "artifact_map_fingerprint": { "$ref": "#/$defs/fp" },
    "shared_writing_contract_fingerprint": { "$ref": "#/$defs/fp" },
    "artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "visible_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "structure_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["heading_count", "paragraph_count", "prose_paragraph_count", "short_prose_paragraph_count", "list_item_count", "disallowed_list_item_count", "placeholder_count", "workflow_leak_count", "body_character_count"],
      "properties": {
        "heading_count": { "type": "integer", "minimum": 0 },
        "paragraph_count": { "type": "integer", "minimum": 0 },
        "prose_paragraph_count": { "type": "integer", "minimum": 0 },
        "short_prose_paragraph_count": { "type": "integer", "minimum": 0 },
        "list_item_count": { "type": "integer", "minimum": 0 },
        "disallowed_list_item_count": { "type": "integer", "minimum": 0 },
        "placeholder_count": { "type": "integer", "minimum": 0 },
        "workflow_leak_count": { "type": "integer", "minimum": 0 }
        ,"body_character_count": { "type": "integer", "minimum": 0 },
        "extent_unit": { "enum": ["characters", "words", "sentences"] },
        "extent_count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" }, "uniqueItems": true },
    "quality_dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["current_bytes", "structure_lock", "exact_preservation", "citation_placement", "list_zones", "fragmentation", "binding_coverage"],
      "properties": {
        "current_bytes": { "$ref": "#/$defs/status" },
        "structure_lock": { "$ref": "#/$defs/status" },
        "exact_preservation": { "$ref": "#/$defs/status" },
        "citation_placement": { "$ref": "#/$defs/status" },
        "list_zones": { "$ref": "#/$defs/status" },
        "fragmentation": { "$ref": "#/$defs/status" },
        "language_fit": { "$ref": "#/$defs/status" },
        "binding_coverage": { "$ref": "#/$defs/status" }
      }
    },
    "status": { "enum": ["passed", "repair", "blocked", "stale"] },
    "audited_at": { "type": "string", "format": "date-time" },
    "audit_fingerprint": { "$ref": "#/$defs/fp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["passed", "repair", "blocked", "not_applicable"] },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "code", "severity", "message", "affected_unit_ids", "repair_owner", "preservation_boundary"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["blocking", "repair"] },
        "message": { "type": "string", "minLength": 1 },
        "affected_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "repair_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide", "reader-kernel", "human"] },
        "preservation_boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
