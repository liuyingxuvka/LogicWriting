{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/researchguard-consumption-binding.schema.json",
  "title": "ResearchGuard semantic handoff consumption binding",
  "description": "A hash-bound, exhaustive join between one semantic ResearchGuard handoff and one current LogicWriting ReaderBrief.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_fingerprint", "reader_intent_fingerprint",
    "composition_plan_fingerprint", "brief_fingerprint", "writer_input_fingerprint",
    "unit_mapping", "native_unit_ids", "planned_unit_ids", "claim_boundary",
    "binding_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "researchguard.logic.consumption-binding.v1" },
    "handoff_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "composition_plan_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "brief_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "writer_input_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "unit_mapping": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unitMapping" }
    },
    "native_unit_ids": {
      "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true
    },
    "planned_unit_ids": {
      "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true
    },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "binding_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 2, "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fingerprint": {
      "type": "string", "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "unitMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["native_unit_id", "planned_unit_ids", "disposition", "reason"],
      "properties": {
        "native_unit_id": { "$ref": "#/$defs/identifier" },
        "planned_unit_ids": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true
        },
        "disposition": {
          "enum": ["body", "note", "appendix", "omit", "merged", "implied_by_scope"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
