{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/local-single-judgment.schema.json",
  "title": "Logic Writing local single article judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_fingerprint",
    "reverse_outline",
    "obligation_results",
    "scores",
    "defects",
    "required_repairs"
  ],
  "properties": {
    "schema_version": { "const": "logic-writing.local-single-judgment.v1" },
    "artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "reverse_outline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reverseOutline" }
    },
    "obligation_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/obligationResult" }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clarity",
        "coherence",
        "naturalness",
        "reader_fit",
        "genre_fit",
        "content_fidelity",
        "instruction_fidelity",
        "structure_fidelity"
      ],
      "properties": {
        "clarity": { "$ref": "#/$defs/score" },
        "coherence": { "$ref": "#/$defs/score" },
        "naturalness": { "$ref": "#/$defs/score" },
        "reader_fit": { "$ref": "#/$defs/score" },
        "genre_fit": { "$ref": "#/$defs/score" },
        "content_fidelity": { "$ref": "#/$defs/score" },
        "instruction_fidelity": { "$ref": "#/$defs/score" },
        "structure_fidelity": { "$ref": "#/$defs/score" }
      }
    },
    "defects": {
      "type": "array",
      "items": { "$ref": "#/$defs/defect" }
    },
    "required_repairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/repair" }
    }
  },
  "$defs": {
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "text": { "type": "string", "minLength": 1 },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reverseOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "excerpt", "function"],
      "properties": {
        "unit": { "$ref": "#/$defs/text" },
        "excerpt": { "$ref": "#/$defs/text" },
        "function": { "$ref": "#/$defs/text" },
        "forward_link": { "$ref": "#/$defs/text" }
      }
    },
    "obligationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "status", "unit", "excerpt"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["passed", "failed", "unknown"] },
        "unit": { "$ref": "#/$defs/text" },
        "excerpt": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "excerpt", "reason"],
      "properties": {
        "severity": { "enum": ["blocking", "repair", "observation", "minor"] },
        "obligation_id": { "$ref": "#/$defs/id" },
        "unit": { "$ref": "#/$defs/text" },
        "excerpt": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "repair": { "$ref": "#/$defs/text" }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "repair"],
      "properties": {
        "unit": { "$ref": "#/$defs/text" },
        "repair": { "$ref": "#/$defs/text" }
      }
    }
  }
}
