{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/route-decision.schema.json",
  "title": "Logic Writing RouteDecision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "request_fingerprint", "reader_intent",
    "reader_intent_fingerprint", "terminal_deliverable", "final_owner", "child_routes",
    "material_assumptions", "intent_conflicts", "status", "reason", "stale_because",
    "decided_at", "decision_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "decision_id": { "$ref": "#/$defs/identifier" },
    "request_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "reader_intent": { "$ref": "reader-intent.schema.json" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "terminal_deliverable": { "$ref": "writing-request.schema.json#/$defs/terminalDeliverable" },
    "final_owner": { "type": ["string", "null"], "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide", null] },
    "child_routes": { "type": "array", "items": { "const": "investigation" }, "maxItems": 1, "uniqueItems": true },
    "material_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "intent_conflicts": { "type": "array", "items": { "$ref": "composition-plan.schema.json#/$defs/conflict" }, "uniqueItems": true },
    "status": { "enum": ["current", "skipped", "ambiguous", "blocked", "stale"] },
    "reason": { "type": "string", "minLength": 1 },
    "stale_because": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "decided_at": { "type": "string", "format": "date-time" },
    "decision_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "current" } }, "required": ["status"] },
      "then": {
        "properties": {
          "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
          "intent_conflicts": { "maxItems": 0 },
          "stale_because": { "maxItems": 0 }
        }
      },
      "else": { "properties": { "final_owner": { "type": "null" }, "child_routes": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "properties": { "intent_conflicts": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "stale" } }, "required": ["status"] },
      "then": { "properties": { "stale_because": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
