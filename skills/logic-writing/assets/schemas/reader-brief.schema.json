{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/reader-brief.schema.json",
  "title": "Logic Writing ReaderBrief v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brief_id", "route_decision_fingerprint", "reader_intent_fingerprint",
    "final_owner", "terminal_deliverable", "reader_intent", "content_boundaries",
    "composition_plan", "route_extension", "native_dependency_receipt_fingerprints",
    "content_authority_fingerprints", "brief_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "brief_id": { "$ref": "#/$defs/identifier" },
    "route_decision_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
    "terminal_deliverable": { "$ref": "writing-request.schema.json#/$defs/terminalDeliverable" },
    "reader_intent": { "$ref": "reader-intent.schema.json" },
    "content_boundaries": { "$ref": "#/$defs/contentBoundaries" },
    "composition_plan": { "$ref": "composition-plan.schema.json" },
    "route_extension": { "$ref": "#/$defs/routeExtension" },
    "native_dependency_receipt_fingerprints": {
      "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" }, "uniqueItems": true
    },
    "content_authority_fingerprints": {
      "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/fingerprint" }
    },
    "brief_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contentBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_units", "evidence_anchors", "alternatives", "limitations",
        "citation_duties", "must_preserve_tokens", "verbatim_obligations",
        "prohibited_overclaims"
      ],
      "properties": {
        "content_units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentUnit" }, "uniqueItems": true },
        "evidence_anchors": { "type": "array", "items": { "$ref": "#/$defs/evidenceAnchor" }, "uniqueItems": true },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" }, "uniqueItems": true },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" }, "uniqueItems": true },
        "citation_duties": { "type": "array", "items": { "$ref": "#/$defs/citationDuty" }, "uniqueItems": true },
        "must_preserve_tokens": { "type": "array", "items": { "$ref": "#/$defs/preserveToken" }, "uniqueItems": true },
        "verbatim_obligations": { "type": "array", "items": { "$ref": "#/$defs/verbatim" }, "uniqueItems": true },
        "prohibited_overclaims": { "type": "array", "items": { "$ref": "#/$defs/overclaim" }, "uniqueItems": true }
      }
    },
    "contentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_unit_id", "safe_meaning", "required", "evidence_anchor_ids", "alternative_ids", "limitation_ids", "model_row_ids"],
      "properties": {
        "content_unit_id": { "$ref": "#/$defs/identifier" },
        "safe_meaning": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "evidence_anchor_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "alternative_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "limitation_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "model_row_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      }
    },
    "evidenceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "source_id", "locator", "relation", "observed_summary", "boundary"],
      "properties": {
        "anchor_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "locator": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["support", "limit", "counter", "context"] },
        "observed_summary": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative_id", "safe_meaning", "status", "content_unit_ids"],
      "properties": {
        "alternative_id": { "$ref": "#/$defs/identifier" },
        "safe_meaning": { "type": "string", "minLength": 1 },
        "status": { "enum": ["live", "qualified", "rejected", "unsupported"] },
        "content_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "safe_meaning", "affected_content_unit_ids", "required_placement"],
      "properties": {
        "limitation_id": { "$ref": "#/$defs/identifier" },
        "safe_meaning": { "type": "string", "minLength": 1 },
        "affected_content_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "required_placement": { "enum": ["same_unit", "adjacent_unit", "conclusion", "appendix"] }
      }
    },
    "citationDuty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "content_unit_ids", "source_id", "marker", "placement"],
      "properties": {
        "citation_id": { "$ref": "#/$defs/identifier" },
        "content_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "source_id": { "$ref": "#/$defs/identifier" },
        "marker": { "type": "string", "minLength": 1 },
        "placement": { "enum": ["same_sentence", "same_paragraph", "same_unit", "footnote", "endnote"] }
      }
    },
    "preserveToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "token", "reason", "content_unit_ids"],
      "properties": {
        "token_id": { "$ref": "#/$defs/identifier" },
        "token": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "content_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      }
    },
    "verbatim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbatim_id", "text", "reason", "content_unit_ids"],
      "properties": {
        "verbatim_id": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "content_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      }
    },
    "overclaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overclaim_id", "affected_content_unit_ids", "forbidden_meaning", "reason", "authority_refs"],
      "properties": {
        "overclaim_id": { "$ref": "#/$defs/identifier" },
        "affected_content_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "forbidden_meaning": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "authority_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "routeExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "profile", "schema_name", "extension_fingerprint", "native_receipt_fingerprints"],
      "properties": {
        "owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
        "profile": { "type": "string", "minLength": 1 },
        "schema_name": {
          "enum": [
            "investigation-composition.schema.json", "academic-composition.schema.json",
            "fiction-composition.schema.json", "travel-composition.schema.json"
          ]
        },
        "extension_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "native_receipt_fingerprints": { "type": "array", "items": { "$ref": "#/$defs/fingerprint" }, "uniqueItems": true }
      }
    }
  }
}
