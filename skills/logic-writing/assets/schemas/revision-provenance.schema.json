{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/revision-provenance.schema.json",
  "title": "Logic Writing route-neutral revision provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provenance_id", "final_owner", "artifact_mode",
    "reader_intent_fingerprint", "source_artifact_fingerprint",
    "target_artifact_fingerprint", "applicability", "unit_treatments",
    "recorded_at", "provenance_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "provenance_id": { "$ref": "#/$defs/id" },
    "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
    "artifact_mode": { "enum": ["create_new", "revise_existing"] },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fp" },
    "source_artifact_fingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "target_artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "applicability": { "enum": ["required", "not_applicable"] },
    "unit_treatments": { "type": "array", "items": { "$ref": "#/$defs/treatment" }, "uniqueItems": true },
    "recorded_at": { "type": "string", "format": "date-time" },
    "provenance_fingerprint": { "$ref": "#/$defs/fp" }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_mode": { "const": "create_new" } }, "required": ["artifact_mode"] },
      "then": {
        "properties": {
          "source_artifact_fingerprint": { "type": "null" },
          "applicability": { "const": "not_applicable" },
          "unit_treatments": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "source_artifact_fingerprint": { "$ref": "#/$defs/fp" },
          "applicability": { "const": "required" },
          "unit_treatments": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "treatment": {
      "type": "object", "additionalProperties": false,
      "required": ["source_unit_id", "target_unit_ids", "treatment", "authorization", "meaning_delta", "structure_delta"],
      "properties": {
        "source_unit_id": { "$ref": "#/$defs/id" },
        "target_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "treatment": { "enum": ["preserved", "rewritten", "moved", "split", "merged", "omitted"] },
        "authorization": { "type": "string", "minLength": 1 },
        "meaning_delta": { "type": "string", "minLength": 1 },
        "structure_delta": { "type": "string", "minLength": 1 }
      }
    }
  }
}
