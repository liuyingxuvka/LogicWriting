{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/reader-repair-request.schema.json",
  "title": "Logic Writing ReaderRepairRequest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repair_id", "attempt_number", "final_owner",
    "source_artifact_fingerprint", "reader_intent_fingerprint", "reader_brief_fingerprint",
    "composition_plan_fingerprint", "artifact_map_fingerprint", "shared_writing_contract_fingerprint",
    "audit_fingerprint", "route_audit_fingerprint", "judgment_fingerprint",
    "defect_lineage", "defect_set_fingerprint", "target_unit_ids", "required_changes",
    "preserve_content_unit_ids", "must_preserve_tokens", "forbidden_shortcuts",
    "request_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "repair_id": { "$ref": "#/$defs/id" },
    "attempt_number": { "type": "integer", "minimum": 1 },
    "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
    "source_artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_brief_fingerprint": { "$ref": "#/$defs/fp" },
    "composition_plan_fingerprint": { "$ref": "#/$defs/fp" },
    "artifact_map_fingerprint": { "$ref": "#/$defs/fp" },
    "shared_writing_contract_fingerprint": { "$ref": "#/$defs/fp" },
    "audit_fingerprint": { "$ref": "#/$defs/fp" },
    "route_audit_fingerprint": { "$ref": "#/$defs/fp" },
    "judgment_fingerprint": { "$ref": "#/$defs/fp" },
    "defect_lineage": { "$ref": "#/$defs/id" },
    "defect_set_fingerprint": { "$ref": "#/$defs/fp" },
    "target_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "required_changes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "preserve_content_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "must_preserve_tokens": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "forbidden_shortcuts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "request_fingerprint": { "$ref": "#/$defs/fp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
