{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/artifact-map.schema.json",
  "title": "Logic Writing ArtifactMap v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "map_id", "artifact_path", "artifact_format", "artifact_fingerprint",
    "language", "units", "unmapped_ranges", "map_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "map_id": { "$ref": "#/$defs/id" },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_format": { "enum": ["text", "markdown"] },
    "artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "language": { "type": "string", "minLength": 1 },
    "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" }, "uniqueItems": true },
    "unmapped_ranges": { "type": "array", "items": { "$ref": "#/$defs/range" }, "uniqueItems": true },
    "map_fingerprint": { "$ref": "#/$defs/fp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_unit_id", "parent_unit_id", "unit_kind", "zone", "order",
        "heading_level", "locator", "start", "end", "text", "content_fingerprint"
      ],
      "properties": {
        "artifact_unit_id": { "$ref": "#/$defs/id" },
        "parent_unit_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "unit_kind": { "enum": ["document", "heading", "paragraph", "list", "list_item", "table", "quote", "code", "scene", "chapter", "appendix", "source_boundary", "recheck_note"] },
        "zone": { "enum": ["narrative", "prose", "functional_list", "table", "scene", "operational_appendix", "source_boundary", "recheck", "other"] },
        "order": { "type": "integer", "minimum": 1 },
        "heading_level": { "type": "integer", "minimum": 0, "maximum": 6 },
        "locator": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "content_fingerprint": { "$ref": "#/$defs/fp" }
      }
    }
  }
}
