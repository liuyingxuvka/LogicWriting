{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/LogicWriting/schemas/reader-judgment.schema.json",
  "title": "Logic Writing independent ReaderJudgment v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "judgment_id", "final_owner", "producer_id", "judge_id",
    "evaluation_profile_fingerprint", "reader_intent_fingerprint", "reader_brief_fingerprint",
    "composition_plan_fingerprint", "artifact_map_fingerprint",
    "shared_writing_contract_fingerprint", "deterministic_audit_fingerprint",
    "route_audit_fingerprint", "artifact_fingerprint", "reverse_outline", "scores",
    "defects", "strengths", "required_repairs", "status", "judged_at", "judgment_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "judgment_id": { "$ref": "#/$defs/id" },
    "final_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide"] },
    "producer_id": { "$ref": "#/$defs/id" },
    "judge_id": { "$ref": "#/$defs/id" },
    "evaluation_profile_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_intent_fingerprint": { "$ref": "#/$defs/fp" },
    "reader_brief_fingerprint": { "$ref": "#/$defs/fp" },
    "composition_plan_fingerprint": { "$ref": "#/$defs/fp" },
    "artifact_map_fingerprint": { "$ref": "#/$defs/fp" },
    "shared_writing_contract_fingerprint": { "$ref": "#/$defs/fp" },
    "deterministic_audit_fingerprint": { "$ref": "#/$defs/fp" },
    "route_audit_fingerprint": { "$ref": "#/$defs/fp" },
    "artifact_fingerprint": { "$ref": "#/$defs/fp" },
    "execution_record_fingerprint": { "$ref": "#/$defs/fp" },
    "review_obligation_manifest_fingerprint": { "$ref": "#/$defs/fp" },
    "reverse_outline": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outline" }, "uniqueItems": true },
    "scores": { "$ref": "#/$defs/scores" },
    "defects": { "type": "array", "items": { "$ref": "#/$defs/observation" }, "uniqueItems": true },
    "strengths": { "type": "array", "items": { "$ref": "#/$defs/observation" }, "uniqueItems": true },
    "required_repairs": { "type": "array", "items": { "$ref": "#/$defs/repair" }, "uniqueItems": true },
    "status": { "enum": ["passed", "repair", "blocked", "stale"] },
    "judged_at": { "type": "string", "format": "date-time" },
    "judgment_fingerprint": { "$ref": "#/$defs/fp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "fp": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "spanEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_unit_id", "locator", "excerpt", "excerpt_fingerprint"],
      "properties": {
        "artifact_unit_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "excerpt_fingerprint": { "$ref": "#/$defs/fp" }
      }
    },
    "outline": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_unit_id", "parent_unit_id", "observed_job", "main_point", "support_or_action", "content_unit_ids", "carries_from_unit_ids", "relation_to_previous", "downstream_effect", "orphaned", "overloaded", "evidence"],
      "properties": {
        "artifact_unit_id": { "$ref": "#/$defs/id" },
        "parent_unit_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "observed_job": { "type": "string", "minLength": 1 },
        "main_point": { "type": "string", "minLength": 1 },
        "support_or_action": { "type": "string", "minLength": 1 },
        "content_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "carries_from_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "relation_to_previous": { "type": "string", "minLength": 1 },
        "downstream_effect": { "type": "string", "minLength": 1 },
        "orphaned": { "type": "boolean" },
        "overloaded": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/spanEvidence" }
      }
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["clarity", "structure_fidelity", "coherence", "naturalness", "reader_fit", "content_fidelity", "genre_fit", "instruction_fidelity"],
      "properties": {
        "clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "structure_fidelity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "coherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "naturalness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "reader_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "content_fidelity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "genre_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "instruction_fidelity": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "dimension", "message", "severity", "evidence"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "dimension": { "enum": ["clarity", "structure_fidelity", "coherence", "naturalness", "reader_fit", "content_fidelity", "genre_fit", "instruction_fidelity"] },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocking", "repair", "strength"] },
        "evidence": { "$ref": "#/$defs/spanEvidence" }
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": ["repair_id", "defect_ids", "target_unit_ids", "required_change", "repair_owner"],
      "properties": {
        "repair_id": { "$ref": "#/$defs/id" },
        "defect_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "target_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "required_change": { "type": "string", "minLength": 1 },
        "repair_owner": { "enum": ["investigation", "academic-writing", "fiction-writing", "travel-guide", "reader-kernel", "human"] }
      }
    }
  }
}
