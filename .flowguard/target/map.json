        "reader-plan:build_reader_brief reads route-decision.json",
        "reader-binding:build_artifact_map reads piece.md",
        "reader-binding:validate_shared_writing reads artifact-map.json",
        "reader-checks:build_reader_audit reads shared-writing-result.json",
        "reader-checks:validate_route_artifact_review reads shared-writing-result.json",
        "reader-closure:derive_closure reads route-review-result.json"
      ],
