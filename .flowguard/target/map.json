      "layer": "entry",
      "summary": "Select exactly one final owner and bounded investigation child.",
      "responsibilities": [
        "Choose one final owner from the requested terminal artifact; an open material reader choice stops routing with needs_user_choice after conflict and trivial-request checks.",
